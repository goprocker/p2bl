# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=local_ai_agent

# ---- Ollama (local LLM) ----
OLLAMA_HOST=http://localhost:11434
# Chat model. Must support tool calling (qwen3, llama3.1, mistral-nemo, ...)
OLLAMA_MODEL=qwen3
# Embedding model used for vector memory (pull with: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Sampling temperature for the chat model
OLLAMA_TEMPERATURE=0.3

# ---- Groq cloud chat (preferred when GROQ_API_KEY is set) ----
# Keep the real key only in .env. Never commit it.
GROQ_API_KEY= 
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Vector store (ChromaDB, embedded / on-disk) ----
CHROMA_DIR=./chroma_data

# ---- Weather ----
# Optional. If set, OpenWeatherMap is used. If empty, the free no-key
# Open-Meteo API is used, with Playwright browser search as last resort.
OPENWEATHER_API_KEY=

# ---- Voice (all local) ----
# Whisper model for speech-to-text: tiny | base | small | medium
# (bigger = more accurate but slower; downloaded automatically on first use)
WHISPER_MODEL=base
# Force a language ("en", "ta", ...) or leave empty to auto-detect
WHISPER_LANGUAGE=en
# TTS engine: auto (Piper if voice file exists, else macOS 'say') | piper | say
TTS_ENGINE=auto
# Path to a Piper .onnx voice (download from https://huggingface.co/rhasspy/piper-voices)
PIPER_VOICE_PATH=./voices/en_US-lessac-medium.onnx
# macOS 'say' voice name (only used by the say engine); empty = system default
SAY_VOICE=

# ---- Agent behaviour ----
# Max reasoning/tool-use iterations per user message
MAX_AGENT_STEPS=6
# Seconds a single tool call may run before it is aborted
TOOL_TIMEOUT_SECONDS=60
# How many past messages of the conversation to feed back to the LLM
HISTORY_LIMIT=12

# ---- API / frontend ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Smart room (ProjectMyRoom API bridge) ----
# The Express server from ../ProjectMyRoom (npm start). Leave token empty to disable.
MYROOM_API_URL=http://localhost:3100
MYROOM_API_TOKEN=
# Second safety gate. Dry-run remains the UI default even when enabled.
AUTOMATION_LIVE_ENABLED=false
